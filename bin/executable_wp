#!/usr/bin/python

import argparse
import subprocess

argparser = argparse.ArgumentParser()

sub_parser = argparser.add_subparsers(dest="command")
sub_parser.add_parser("status", help="print status")

sub_parser.add_parser("doh", help="connect to doh mode", aliases=["h"])
sub_parser.add_parser("dot", help="conect to dot mode", aliases=["t"])
sub_parser.add_parser("warp", help="connect to warp mode", aliases=["w"])
sub_parser.add_parser("wp", help="warp mode")
sub_parser.add_parser("wh", help="warp+doh mode")
sub_parser.add_parser("wt", help="warp+dot mode")

sub_parser.add_parser("connect", help="turn on connection to warp-cli", aliases=["c"])
sub_parser.add_parser(
    "disconnect", help="turn off connection to warp-cli", aliases=["d"]
)


def status():
    subprocess.run(["warp-cli", "status"], check=False)
    subprocess.run("warp-cli settings | grep Mode", check=False, shell=True)


def change_mode(mode: str):
    subprocess.run(["warp-cli", "mode", mode], check=False)


def turn_on():
    subprocess.run(["warp-cli", "connect"], check=False)


def turn_off():
    subprocess.run(["warp-cli", "disconnect"], check=False)


if __name__ == "__main__":
    args = argparser.parse_args()
    cmd = args.command

    if cmd in ["status", "s"]:
        status()

    elif cmd in ["dot", "t"]:
        change_mode("dot")
    elif cmd in ["doh", "h"]:
        change_mode("doh")
    elif cmd in ["warp", "w"] or cmd == "wp":
        change_mode("warp")
    elif cmd == "wt":
        change_mode("warp+dot")
    elif cmd == "wh":
        change_mode("warp+doh")

    elif cmd in ["connnect", "c"]:
        turn_on()
    elif cmd in ["disconnect", "d"]:
        turn_off()
    else:
        status()
